{
  "name": "aerial-rescue-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "26.7.0",
    "pnpm": "11.23.0"
  },
  "config": {
    "playwrightExpectedTests": 64
  },
  "scripts": {
    "build": "vite build",
    "contracts:check": "node scripts/generate-dashboard-contracts.ts --check",
    "contracts:generate": "node scripts/generate-dashboard-contracts.ts --write",
    "dev": "vite --host 127.0.0.1",
    "dev:test": "vite --host 127.0.0.1 --port 4173 --strictPort --mode test",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.thresholds.statements=95 --coverage.thresholds.branches=95 --coverage.thresholds.functions=95 --coverage.thresholds.lines=95",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:production": "DASHBOARD_E2E_DRIVER=production playwright test --config playwright.production.config.ts",
    "test:e2e:soak": "DASHBOARD_E2E_DRIVER=production playwright test --config playwright.soak.config.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "maplibre-gl": "6.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  }
}
