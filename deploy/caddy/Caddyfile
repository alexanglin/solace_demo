{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data: blob:; object-src 'none'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	reverse_proxy unix//run/aerial-rescue/dashboard-api.sock {
		flush_interval -1
		header_up Host {http.request.hostport}
		header_up Origin {http.request.header.Origin}
		header_up -Forwarded
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
		header_down -Content-Security-Policy
		header_down -Referrer-Policy
		header_down -X-Content-Type-Options
	}
}
