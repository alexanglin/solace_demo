# Environment template. Copy to `.env` and fill in real values.
#
# `.env` is ignored by Git and blocked by the `no-env-files` hook. Only this file is
# tracked, and `scripts/hooks/check-env-template.sh` enforces that every secret-bearing
# name here holds a placeholder rather than a literal. This repository is public, so a
# real value committed here is the one failure a later commit cannot undo
# (AGENTS.md section 6).
#
# Variable names are taken from the pinned runtime and the official images, not invented:
# the Agent Mesh 1.28.7 templates, the Event Mesh Gateway 1.1.0 and Event Mesh Tool 0.1.1
# templates, the Solace AI Connector, the postgres image, and the Event Management Agent
# read the names below. Values are written from the container's point of view, because
# every component except Ollama runs under deploy/compose.yaml (docs/adr/0044); host-run
# tooling reaches the same broker as tcps://localhost:55443 with deploy/certs as its trust
# store.

# --------------------------------------------------------------- Solace broker ---
# The PubSub+ software event broker container is the broker for every gated path
# (docs/adr/0043). Use `tcps` with certificate and hostname validation; WSS on port 443 is
# a documented restricted-network fallback and not a reason to weaken TLS (docs/SAFETY.md).
SOLACE_BROKER_URL=tcps://broker:55443
SOLACE_BROKER_USERNAME=
SOLACE_BROKER_PASSWORD=
SOLACE_BROKER_VPN=default

# The directory holding the authority certificate every client validates against. `just
# secrets` writes it to deploy/certs, which compose mounts at this path (docs/adr/0046).
TRUST_STORE=/etc/aerial-rescue/certs

# Development shortcut in the upstream templates. Leave false; a real broker is the
# supported path for every test that claims broker behaviour.
SOLACE_DEV_MODE=false

# Temporary queues are adequate for a spike. Guaranteed delivery for commands, results,
# evidence, failures, approvals, and audit records needs durable endpoints
# (docs/CONTRACTS.md).
USE_TEMPORARY_QUEUES=true

# The Agent Mesh A2A namespace. ADR-0014 keeps it distinct from aerial-rescue/v1; the value
# is fixed with the first configuration under agent-mesh/configs/.
NAMESPACE=

# Signs the Agent Mesh Web UI session. The image ships a placeholder that must be replaced.
SESSION_SECRET_KEY=<required>

# ------------------------------------------------------------ Orchestration model ---
# The Agent Mesh `general` and `planning` roles. Exactly one provider is active per run
# and readiness reports which. Local-only operation is a first-class tested configuration,
# so leaving every key blank is a supported state
# (docs/adr/0002-paid-orchestration-under-enforced-budget-cap.md).
LLM_SERVICE_ENDPOINT=http://host.docker.internal:11434/v1
LLM_SERVICE_GENERAL_MODEL_NAME=
LLM_SERVICE_API_KEY=

# Paid providers. Both are permitted; the selection is made by measurement in Phase 0.
# Spend is metered against an enforced ledger and a hard USD cap; budget exhaustion must
# only ever cause abstention.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------ Local Ollama ---
# Never expose Ollama publicly. It stays on the host, and containers reach it only through
# the host bridge (docs/ARCHITECTURE.md).
OLLAMA_HOST=http://host.docker.internal:11434

# ----------------------------------------------------------------- Durable store ---
# Names the official postgres image reads. The password is a compose secret file written
# by `just secrets`, never an environment value (docs/adr/0003, docs/adr/0046).
POSTGRES_USER=aerial_rescue
POSTGRES_DB=aerial_rescue

# ------------------------------------------------- Event Portal runtime discovery ---
# Names the Event Management Agent's connection file reads (docs/adr/0043). The discovery
# user is provisioned on the broker with read-only SEMP access in a later increment.
SOLACE_SEMP_USERNAME=
SOLACE_SEMP_PASSWORD=
SOLACE_VPN_NAME=default

# ------------------------------------------------- Showcase profile (Solace Cloud) ---
# Non-gating (docs/adr/0043). Copy this file to the ignored `.env.showcase`, substitute the
# Cloud service's values for the same names, and run `just showcase`:
#   SOLACE_BROKER_URL=tcps://<service-host>.messaging.solace.cloud:55443
#   SOLACE_BROKER_VPN=<service-vpn>
#   SOLACE_BROKER_USERNAME and SOLACE_BROKER_PASSWORD: one client username per component
#   TRUST_STORE=   (empty: the service's public chain validates against the system store)
# Nothing in continuous integration reads it, and no gate depends on it.
