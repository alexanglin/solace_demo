# Environment template. Copy to `.env` and fill in real values.
#
# `.env` is ignored by Git and blocked by the `no-env-files` hook. Only this file is
# tracked, and `scripts/hooks/check-env-template.sh` enforces that every secret-bearing
# name here holds a placeholder rather than a literal. This repository is public, so a
# real value committed here is the one failure a later commit cannot undo
# (AGENTS.md section 6).
#
# Variable names are taken from the pinned runtime and the official images, not invented:
# the Agent Mesh 1.28.7 templates, the Event Mesh Gateway 1.1.0 and Event Mesh Tool 0.1.1
# templates, the Solace AI Connector, the postgres image, and the Event Management Agent
# read the names below. Values are written from the container's point of view, because
# every component except Ollama runs under deploy/compose.yaml (docs/adr/0044); host-run
# tooling reaches the same broker as tcps://localhost:55443 with deploy/certs as its trust
# store.

# --------------------------------------------------------------- Solace broker ---
# The PubSub+ software event broker container is the broker for every gated path
# (docs/adr/0043). Use `tcps` with certificate and hostname validation; WSS on port 443 is
# a documented restricted-network fallback and not a reason to weaken TLS (docs/SAFETY.md).
SOLACE_BROKER_URL=tcps://broker:55443
SOLACE_BROKER_VPN=default

# Optional host-side roots used by Compose. Empty selects deploy/certs and deploy/secrets;
# a disposable worktree can instead supply absolute paths to already-authorized generated
# material without copying, regenerating, rotating, or tracking it.
AERIAL_RESCUE_CERTIFICATE_DIRECTORY=
AERIAL_RESCUE_SECRET_DIRECTORY=

# The opt-in continuous SEMP monitor has no password environment variable. `just secrets`
# writes `semp-monitor-password`; an operator must apply and prove ADR-0181's global-none,
# VPN-default-none, selected-VPN-read-only identity before enabling that profile.

# One client username per authorization role (docs/adr/0061). The usernames are not
# secrets and are the role names themselves, so they carry real values here; a gate test
# holds them equal to the Principal enum in packages/domain. `just secrets` writes each
# password to deploy/secrets/broker-<role>-password; copy it into your own .env, which is
# never tracked.
# fleet-simulator: publishes telemetry, drone and sector events, and command results
SOLACE_FLEET_SIMULATOR_USERNAME=fleet-simulator
SOLACE_FLEET_SIMULATOR_PASSWORD=<required>
# command-gateway: the only role that may publish an executable drone command
SOLACE_COMMAND_GATEWAY_USERNAME=command-gateway
SOLACE_COMMAND_GATEWAY_PASSWORD=<required>
# dashboard-api: publishes operator commands, approvals, and committed mission lifecycle events
SOLACE_DASHBOARD_API_USERNAME=dashboard-api
SOLACE_DASHBOARD_API_PASSWORD=<required>
# evidence-service: publishes validated evidence decisions and audit records
SOLACE_EVIDENCE_SERVICE_USERNAME=evidence-service
SOLACE_EVIDENCE_SERVICE_PASSWORD=<required>
# recorder: reads the validated application stream and publishes nothing
SOLACE_RECORDER_USERNAME=recorder
SOLACE_RECORDER_PASSWORD=<required>
# event-mesh-gateway: salient-event ingress; named by agent-mesh/configs/
SOLACE_EVENT_MESH_GATEWAY_USERNAME=event-mesh-gateway
SOLACE_EVENT_MESH_GATEWAY_PASSWORD=<required>
# event-mesh-tool: gateway requests only; named by agent-mesh/configs/
SOLACE_EVENT_MESH_TOOL_USERNAME=event-mesh-tool
SOLACE_EVENT_MESH_TOOL_PASSWORD=<required>
# agent-mesh-agent: the Agent Mesh runtime's own identity
SOLACE_AGENT_MESH_AGENT_USERNAME=agent-mesh-agent
SOLACE_AGENT_MESH_AGENT_PASSWORD=<required>
# The directory holding the authority certificate every client validates against. `just
# secrets` writes it to deploy/certs, which compose mounts at this path (docs/adr/0046).
TRUST_STORE=/etc/aerial-rescue/certs

# Development shortcut in the upstream templates. Leave false; a real broker is the
# supported path for every test that claims broker behaviour.
SOLACE_DEV_MODE=false

# Temporary queues are adequate for a spike. Guaranteed delivery for commands, results,
# evidence, failures, approvals, and audit records needs durable endpoints
# (docs/CONTRACTS.md).
USE_TEMPORARY_QUEUES=true

# The Agent Mesh A2A namespace, fixed by docs/adr/0064. One level, no trailing slash, and a
# first level distinct from aerial-rescue, so the grant aerial-rescue-mesh/> provably cannot
# reach an application topic. Changing it means re-running `just provision --namespace`.
NAMESPACE=aerial-rescue-mesh

# Signs the Agent Mesh Web UI session. The image ships a placeholder and the upstream check is
# presence-only, so an unreplaced value would sign real sessions. `just secrets` generates it into
# deploy/secrets/.env.roles, which compose reads as a second --env-file and which overrides this
# placeholder. Do not set it by hand (docs/adr/0094).
SESSION_SECRET_KEY=<required>

# ------------------------------------------------------------ Orchestration model ---
# The Agent Mesh `general` and `planning` roles. Exactly one provider is active per run
# and readiness reports which. Local-only operation is a first-class tested configuration,
# so leaving every key blank is a supported state
# (docs/adr/0002-paid-orchestration-under-enforced-budget-cap.md).
LLM_SERVICE_ENDPOINT=http://host.docker.internal:11434/v1
LLM_SERVICE_GENERAL_MODEL_NAME=
LLM_SERVICE_API_KEY=

# Paid providers. Both are permitted; the selection is made by measurement in Phase 0.
# Spend is metered against an enforced ledger and a hard USD cap; budget exhaustion must
# only ever cause abstention.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------ Local Ollama ---
# Never expose Ollama publicly. It stays on the host, and containers reach it only through
# the host bridge (docs/ARCHITECTURE.md).
OLLAMA_HOST=http://host.docker.internal:11434

# ----------------------------------------------------------------- Durable store ---
# Names the official postgres image reads. The password is a compose secret file written
# by `just secrets`, never an environment value (docs/adr/0003, docs/adr/0046).
POSTGRES_USER=aerial_rescue
POSTGRES_DB=aerial_rescue

# ------------------------------------------------- Event Portal runtime discovery ---
# Names the optional Event Management Agent's connection file reads (docs/adr/0043). The repository
# neither provisions this SEMP user nor generates its password. Supply an existing read-only identity
# through an ignored environment file only when intentionally enabling the `event-portal` profile
# (docs/adr/0129). This separate discovery integration is not the `aerialrescuemonitor`
# queue-health identity from ADR-0181.
SOLACE_SEMP_USERNAME=
SOLACE_SEMP_PASSWORD=
SOLACE_VPN_NAME=default

# ------------------------------------------------- Showcase profile (Solace Cloud) ---
# Non-gating (docs/adr/0043). Copy this file to the ignored `.env.showcase`, substitute the
# Cloud service's values for the same names, and run `just showcase`:
#   SOLACE_BROKER_URL=tcps://<service-host>.messaging.solace.cloud:55443
#   SOLACE_BROKER_VPN=<service-vpn>
#   SOLACE_BROKER_USERNAME and SOLACE_BROKER_PASSWORD: one client username per component
#   TRUST_STORE=   (empty: the service's public chain validates against the system store)
# Nothing in continuous integration reads it, and no gate depends on it.
