{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerial-rescue.invalid/schemas/v1/scenario/catalog.schema.json",
  "description": "The version-one inventory that maps validated scenario identities to confined definition files and their exact-byte digests.",
  "type": "object",
  "required": [
    "catalogVersion",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "catalogVersion": {
      "const": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": [
        "identifier",
        "revision",
        "definitionPath",
        "definitionSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "definitionPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^v1/(?:[a-z0-9]|[a-z0-9][a-z0-9-]{0,62}[a-z0-9])\\.r[1-9][0-9]*\\.json$"
        },
        "definitionSha256": {
          "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/lowercaseSha256"
        }
      }
    }
  }
}
