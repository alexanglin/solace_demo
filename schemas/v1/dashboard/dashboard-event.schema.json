{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerial-rescue.invalid/schemas/v1/dashboard/dashboard-event.schema.json",
  "description": "One normalized dashboard event, with transport-only envelope members removed.",
  "anyOf": [
    {
      "$ref": "#/$defs/droneTelemetry"
    },
    {
      "$ref": "#/$defs/connectivityChanged"
    },
    {
      "$ref": "#/$defs/missionLifecycle"
    },
    {
      "$ref": "#/$defs/sectorLifecycle"
    }
  ],
  "$defs": {
    "droneTelemetry": {
      "type": "object",
      "required": [
        "kind",
        "eventClass",
        "mission",
        "time",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "droneTelemetry"
        },
        "eventClass": {
          "const": "TELEMETRY"
        },
        "mission": {
          "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/identifier"
        },
        "time": {
          "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/instant"
        },
        "data": {
          "type": "object",
          "required": [
            "droneId",
            "latitudeMicrodegrees",
            "longitudeMicrodegrees",
            "batteryPercent",
            "altitudeMetres",
            "headingDegrees",
            "groundSpeedCentimetresPerSecond"
          ],
          "additionalProperties": false,
          "properties": {
            "droneId": {
              "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/identifier"
            },
            "latitudeMicrodegrees": {
              "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/latitudeMicrodegrees"
            },
            "longitudeMicrodegrees": {
              "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/longitudeMicrodegrees"
            },
            "batteryPercent": {
              "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/percent"
            },
            "altitudeMetres": {
              "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/altitudeMetres"
            },
            "headingDegrees": {
              "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/headingDegrees"
            },
            "groundSpeedCentimetresPerSecond": {
              "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/groundSpeedCentimetresPerSecond"
            }
          }
        }
      }
    },
    "connectivityChanged": {
      "type": "object",
      "required": [
        "kind",
        "eventClass",
        "mission",
        "time",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "connectivityChanged"
        },
        "eventClass": {
          "const": "CONNECTIVITY"
        },
        "mission": {
          "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/identifier"
        },
        "time": {
          "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/instant"
        },
        "data": {
          "type": "object",
          "required": [
            "droneId",
            "connectivity"
          ],
          "additionalProperties": false,
          "properties": {
            "droneId": {
              "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/identifier"
            },
            "connectivity": {
              "enum": [
                "CONNECTED",
                "DEGRADED",
                "OFFLINE"
              ]
            }
          }
        }
      }
    },
    "missionLifecycle": {
      "type": "object",
      "required": [
        "kind",
        "eventClass",
        "mission",
        "time",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "missionLifecycle"
        },
        "eventClass": {
          "const": "MISSION"
        },
        "mission": {
          "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/identifier"
        },
        "time": {
          "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/instant"
        },
        "data": {
          "type": "object",
          "required": [
            "lifecycle"
          ],
          "additionalProperties": false,
          "properties": {
            "lifecycle": {
              "enum": [
                "PLANNED",
                "SEARCHING",
                "EXHAUSTED",
                "ABORTED"
              ]
            }
          }
        }
      }
    },
    "sectorLifecycle": {
      "type": "object",
      "required": [
        "kind",
        "eventClass",
        "mission",
        "time",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "sectorLifecycle"
        },
        "eventClass": {
          "const": "MISSION"
        },
        "mission": {
          "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/identifier"
        },
        "time": {
          "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/instant"
        },
        "data": {
          "type": "object",
          "required": [
            "sectorId",
            "state",
            "assignedMemberId"
          ],
          "additionalProperties": false,
          "properties": {
            "sectorId": {
              "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/identifier"
            },
            "state": {
              "enum": [
                "UNASSIGNED",
                "ASSIGNED",
                "AT_RISK",
                "SEARCHED"
              ]
            },
            "assignedMemberId": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/identifier"
                }
              ]
            }
          }
        }
      }
    }
  }
}
