{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerial-rescue.invalid/schemas/v1/dashboard/readiness.schema.json",
  "description": "Mode-specific dashboard readiness without secret configuration.",
  "type": "object",
  "required": [
    "readinessVersion",
    "mode",
    "ready",
    "reasons"
  ],
  "additionalProperties": false,
  "properties": {
    "readinessVersion": {
      "const": "dashboard-readiness/v1"
    },
    "mode": {
      "enum": [
        "degradedLive",
        "replay"
      ]
    },
    "ready": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/kind"
      }
    }
  }
}
