{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerial-rescue.invalid/schemas/v1/rpc/fleet-control-run-status.schema.json",
  "description": "The fleet worker's current operational status and publication instruments for one run.",
  "type": "object",
  "required": [
    "controlVersion",
    "missionId",
    "runId",
    "state",
    "completedTickCount",
    "telemetryPublicationCount"
  ],
  "additionalProperties": false,
  "properties": {
    "controlVersion": {
      "const": 1
    },
    "missionId": {
      "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/identifier"
    },
    "runId": {
      "$ref": "https://aerial-rescue.invalid/schemas/v1/canonical.schema.json#/$defs/identifier"
    },
    "state": {
      "enum": [
        "ACCEPTED",
        "RUNNING",
        "EXHAUSTED",
        "CANCELLED",
        "FAILED"
      ]
    },
    "completedTickCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "telemetryPublicationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
