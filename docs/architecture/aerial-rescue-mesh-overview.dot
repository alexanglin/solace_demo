digraph AerialRescueMesh {
  graph [
    rankdir=LR,
    bgcolor="#FFFFFF",
    pad="0.35",
    nodesep="0.42",
    ranksep="0.80",
    splines=polyline,
    compound=true,
    newrank=true,
    fontname="Helvetica",
    fontsize=20,
    label="Aerial Rescue Mesh — open-source Solace-first architecture on Docker Compose",
    labelloc=t
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#314158",
    fillcolor="#F7F9FC",
    fontname="Helvetica",
    fontsize=10,
    margin="0.16,0.11"
  ];

  edge [
    color="#52657A",
    fontcolor="#314158",
    fontname="Helvetica",
    fontsize=9,
    arrowsize=0.7
  ];

  subgraph cluster_operator {
    label="Operator browser — loopback only";
    color="#B7C3D0";
    style="rounded,dashed";
    dashboard [label="Wilderness mission dashboard :8080\nmap • fleet • timeline • replay", fillcolor="#E8F7F1"];
    sam_ui [label="Agent Mesh Web UI :8000\nActivity • Agents • tasks", fillcolor="#E8F7F1"];
    broker_ui [label="PubSub+ Broker Manager :1943\nclients • queues • Try Me", fillcolor="#E8F7F1"];
  }

  subgraph cluster_mac {
    label="Apple Silicon reference workstation — 64 GB — Docker Desktop";
    color="#8193A6";
    style="rounded";

    subgraph cluster_compose {
      label="One shared aerial-rescue-mesh Compose project — deploy/compose.yaml — published endpoints bind only 127.0.0.1";
      color="#2F6FB7";
      style="rounded";

      local_broker [label="PubSub+ Standard 10.26.0 container\ntcps 55443 • SEMP/TLS 1943\nthe broker for every gated path (ADR-0043)", shape=cylinder, fillcolor="#DFF7EE", color="#008F6B"];
      postgres [label="PostgreSQL 18 container\ndurable mission store (ADR-0003)", shape=cylinder, fillcolor="#EEF2F6"];

      subgraph cluster_sam {
        label="Agent Mesh 1.28.7 — official image + pinned plugins — default profile";
        color="#00A67D";
        style="rounded";
        sam_gateways [label="Official gateways and tool\nHTTP/SSE • Event Mesh Gateway 1.1.0\nEvent Mesh Tool 0.1.1", fillcolor="#DFF7EE", color="#008F6B"];
        sam_runtime [label="Solace Agent Mesh 1.28.7\nA2A discovery • tasks • artifacts • evals", fillcolor="#DFF7EE", color="#008F6B"];
        sam_logic [label="Orchestrator + Mission Response workflow\nMission Coordinator • Evidence Fusion\n3 independent A2A edge agents"];

        sam_gateways -> sam_runtime [label="A2A", dir=both];
        sam_runtime -> sam_logic [label="discover / delegate", dir=both];
      }

      subgraph cluster_app {
        label="Mission-control extension — seven selected targets reuse the healthy shared broker and PostgreSQL";
        color="#6B86A5";
        style="rounded";
        caddy [label="Caddy 2.11.4 :8080\nsecurity headers • unbuffered SSE", fillcolor="#E8F7F1"];
        api [label="FastAPI dashboard API\nprivate Unix socket\nbootstrap • snapshots • SSE"];
        app_core [label="Mission slice services\nmigration • 20-drone fleet • scenario\nrecorder • isolated replay validator"];
        app_adapter [label="Solace PubSub+ Python API boundary\ndirect telemetry + guaranteed lifecycle", fillcolor="#DFF7EE", color="#008F6B"];

        caddy -> api [label="dashboard-api.sock", dir=both];
        api -> app_core [dir=both];
        app_core -> app_adapter [dir=both];
      }

      ema [label="Event Management Agent 1.9.9\nprofile event-portal • amd64, emulated\nnon-gating", style="dashed,filled", fillcolor="#F7F9FC"];

      sam_runtime -> local_broker [label="A2A over tcps", dir=both];
      sam_gateways -> local_broker [label="salient events + tool request/reply", dir=both];
      app_adapter -> local_broker [label="validated CloudEvents", dir=both];
      app_core -> postgres [label="runtime • audit", dir=both];
      ema -> local_broker [label="SEMP discovery\n(in-network only)", style=dashed];
    }

    ollama [label="Ollama :11434 on the host\npinned local models\nhost.docker.internal", shape=cylinder, fillcolor="#F0E9FF", color="#7050A0"];
    sam_venv [label="agent-mesh/.venv — Python 3.13.15\nverification only: validator,\ncompatibility probes (ADR-0029)", style="dashed,filled", fillcolor="#F7F9FC"];
    certs [label="scripts/broker-secrets.sh\nper-checkout CA + broker certificate\n(ADR-0046, never tracked)", style="dashed,filled", fillcolor="#FFF7E6", color="#B58900"];

    sam_logic -> ollama [label="local inference", dir=both];
    certs -> local_broker [label="server certificate", style=dashed, color="#B58900", fontcolor="#8A6500"];
  }

  subgraph cluster_cloud {
    label="Solace Cloud — showcase profile, non-gating (ADR-0043) — selected by environment only";
    color="#00A67D";
    style="rounded,dashed";
    cloud_service [label="Developer-class event broker service\nCluster Manager • Broker Manager\nsame identities, queues, traffic", shape=cylinder, style="dashed,filled", fillcolor="#DFF7EE", color="#008F6B"];
    event_portal [label="Event Portal\nDesigner • Catalog • runtime discovery", style="dashed,filled", fillcolor="#DFF7EE", color="#008F6B"];
  }

  dashboard -> caddy [label="loopback HTTP / SSE", dir=both];
  sam_ui -> sam_gateways [label="HTTP / SSE", dir=both];
  broker_ui -> local_broker [label="observe", dir=both];

  sam_runtime -> cloud_service [label="showcase run", style=dashed, dir=both];
  app_adapter -> cloud_service [label="showcase run", style=dashed, dir=both];
  ema -> event_portal [label="outbound discovery scans", style=dashed];

}
