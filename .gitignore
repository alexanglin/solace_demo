# Secrets — never commit. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Python — application workspace (3.14.x) and agent-mesh subproject (3.13.x)
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.hypothesis/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
coverage.json
mutants/
.mutmut-cache

# Node / dashboard
node_modules/
.pnpm-store/
apps/dashboard/dist/
apps/dashboard/.vite/
*.tsbuildinfo
.eslintcache
playwright-report/
test-results/
blob-report/
.playwright/

# pip-audit's HTTP cache layer writes a session file named after its `:memory:` SQLite DSN
# into the working directory. It is an illegal Windows filename, so leaving it untracked
# fails check-illegal-windows-names for anyone who runs scripts/hooks/dependency-audit.sh.
:memory:*

# Local runtime state
*.log
logs/
docker/data/
postgres-data/
recordings/local/

# Local tool caches and agent configuration (repository root only)
/.cache/
/.claude/
/.sam/

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
*.swp
*~

# Agent Mesh local runtime artifacts (configuration under agent-mesh/ IS tracked)
agent-mesh/.venv/
agent-mesh/tmp/
agent-mesh/*.db
agent-mesh/instance/

# Generated Claude Code worktrees. Scoped to the generated subdirectory rather than all
# of .claude/, so shared project configuration there stays trackable if it is ever added.
.claude/worktrees/
